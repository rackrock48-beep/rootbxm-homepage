---
// 소개 섹션: 왼쪽 이미지, 오른쪽 제목과 문단. 글·이미지는 src/content.ts의 about에서 바꾼다.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import placeholder from '../assets/placeholder.svg';

interface Props {
  title: string;
  paragraphs: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  reverse?: boolean; // true면 이미지를 오른쪽에
}
const { title, paragraphs, image, imageAlt = '', reverse = false } = Astro.props;
---

<div class="grid items-start gap-10 lg:grid-cols-[2fr_3fr] lg:gap-16">
  <Image
    src={image ?? placeholder}
    alt={image ? imageAlt : ''}
    width={480}
    height={600}
    class:list={['aspect-[4/5] w-full max-w-[40rem] rounded-3xl bg-surface-accent object-cover', reverse && 'lg:order-last']}
  />
  <div>
    <h2 class="text-28 font-bold md:text-36">{title}</h2>
    <div class="mt-8 space-y-5 text-16 text-foreground-muted md:text-18">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</div>
