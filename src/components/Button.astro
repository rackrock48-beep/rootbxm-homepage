---
// 버튼. href가 있으면 링크(<a>), 없으면 <button>으로 그려진다.
// 내부 링크·앵커는 url('/#services')처럼 url()로 감싸서 넘긴다. 전화는 "tel:0200000000", 카카오톡은 채널 주소 그대로.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'kakao';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  full?: boolean; // 가로로 꽉 채우기
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', type = 'button', full = false, class: className = '', ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-xl font-semibold whitespace-nowrap transition-colors duration-150';
const sizes = {
  md: 'min-h-11 px-5 py-2.5 text-15',
  lg: 'min-h-13 px-7 py-3 text-16',
};
const variants = {
  primary: 'bg-primary text-primary-foreground hover:bg-secondary',
  secondary: 'border border-border-accent bg-background text-foreground hover:border-primary hover:text-primary',
  ghost: 'text-primary hover:bg-primary-surface',
  kakao: 'bg-[#fee500] text-[#191919] hover:bg-[#f2da00]',
};
const classes = [base, sizes[size], variants[variant], full && 'w-full', className];
const external = href?.startsWith('http');
---

{
  href ? (
    <a href={href} class:list={classes} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
