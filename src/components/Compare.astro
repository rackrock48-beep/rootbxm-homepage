---
// "우리가 보는 차이" 비교표. 왼쪽(기존, 흐리게) → 오른쪽(루트, 녹색 강조) 줄마다 짝지어 보여 준다.
// 글은 src/content.ts의 compare에서 바꾼다. footnote의 **굵게** 부분은 녹색 굵은 글씨가 된다.
import { Image } from 'astro:assets';
import tree from '../assets/tree-small.png';
import { compare } from '../content';

const { eyebrow, title, left, right, rows, footnote } = compare;
const parts = footnote.split('**').map((part, i) => ({ part, strong: i % 2 === 1 }));
---

<div class="mx-auto max-w-[96rem] text-center">
  <p class="mb-4 inline-flex rounded-lg bg-primary px-3 py-1 text-14 font-bold text-primary-foreground">{eyebrow}</p>
  <h2 class="text-20 leading-snug font-extrabold whitespace-pre-line md:text-36">{title}</h2>
</div>

<div class="mx-auto mt-14 max-w-[96rem] md:mt-20">
  <!-- 머리줄 (위쪽 여백은 나무가 올라앉을 자리) -->
  <div class="mt-16 grid grid-cols-[1fr_2.4rem_1fr] items-center md:mt-20 gap-3 md:grid-cols-[1fr_4.8rem_1fr] md:gap-4">
    <p class="rounded-2xl bg-surface-accent px-4 py-4 text-center text-15 font-bold text-foreground-muted md:text-18">{left}</p>
    <span></span>
    <!-- 루트 쪽 머리칸 위에 TRUST·PREMIUM 글자 위와 같은 나무를 얹는다 -->
    <p class="relative rounded-2xl bg-primary px-4 py-4 text-center text-15 font-extrabold text-primary-foreground md:text-18">
      <Image src={tree} alt="" aria-hidden="true" width={240} quality={95} class="tree-grow absolute bottom-[92%] left-[calc(100%-4rem)] h-auto w-[5.6rem] -translate-x-1/2 md:left-[calc(100%-5.2rem)] md:w-[7.2rem]" />
      {right}
    </p>
  </div>

  <ul class="mt-3 space-y-3">
    {
      rows.map(([before, after]) => (
        <li class="grid grid-cols-[1fr_2.4rem_1fr] items-center gap-3 md:grid-cols-[1fr_4.8rem_1fr] md:gap-4">
          <p class="flex min-h-16 items-center justify-center rounded-2xl border border-border px-4 py-3 text-center text-14 text-foreground-subtle md:text-16">{before}</p>
          <svg aria-hidden="true" class="mx-auto text-primary" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          <p class="flex min-h-16 items-center justify-center rounded-2xl border border-primary/50 bg-primary-surface px-4 py-3 text-center text-14 font-bold text-foreground md:text-18">{after}</p>
        </li>
      ))
    }
  </ul>

  <p class="mt-12 text-center text-16 text-foreground-muted md:text-20">
    {parts.map(({ part, strong }) =>
      strong ? <strong class="font-extrabold text-primary">{part}</strong> : part.split('|').map((t, j) => (j ? <><br class="md:hidden" /><span class="max-md:hidden"> </span>{t}</> : t)),
    )}
  </p>
</div>
