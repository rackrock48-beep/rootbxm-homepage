---
// 바닥글. 상호·대표자·사업자번호·전화·저작권(이메일·운영시간은 표시하지 않는다). 내용은 src/site.ts에서 바꾼다.
// 아래쪽 여백은 모바일 플로팅 메뉴(QuickMenu)에 가리지 않기 위한 것이다.
import { SITE, url } from '../site';

const { phone, address } = SITE.contact;
const tel = `tel:${phone.replace(/-/g, '')}`;
// 네이버 블로그 주소가 있으면 메뉴 끝에 바깥 링크 탭으로 붙인다
const navItems = SITE.naverBlog ? [...SITE.nav, { href: SITE.naverBlog, label: '네이버 블로그' }] : SITE.nav;
---

<footer class="border-t border-border bg-surface pb-[calc(5.6rem+env(safe-area-inset-bottom))] lg:pb-0">
  <div class="mx-auto grid max-w-site gap-10 px-gutter py-14 md:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="t-mid font-extrabold tracking-tight text-foreground">{SITE.name}</p>
      <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 t-body text-foreground-muted">
        <dt>상호명</dt>
        <dd>{SITE.legal.brand}</dd>
        <dt>법인명</dt>
        <dd>{SITE.legal.company}</dd>
        <dt>대표자</dt>
        <dd>{SITE.legal.representative}</dd>
        <dt>사업자등록번호</dt>
        <dd>{SITE.legal.businessNumber}</dd>
        {address && <dt>주소</dt>}
        {address && <dd>{address}</dd>}
        <dt>전화</dt>
        <dd><a href={tel} class="hover:text-foreground">{phone}</a></dd>
      </dl>
    </div>

    <nav aria-label="바닥글 메뉴" class="md:justify-self-end">
      <ul class="grid grid-cols-2 gap-x-8 sm:grid-cols-3 md:grid-cols-1">
        {
          navItems.map(({ href, label }) => (
            <li>
              <a href={href.startsWith('http') ? href : url(href)} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined} class="flex min-h-10 items-center t-body text-foreground hover:text-primary">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="border-t border-border">
    <p class="mx-auto max-w-site px-gutter py-5 t-body text-foreground-muted lg:pr-28">
      © {new Date().getFullYear()} {SITE.name}. All rights reserved.
    </p>
  </div>
</footer>
