---
// 상단 메뉴. 넓은 화면에서는 가로 앵커 메뉴 + "문의하기" 버튼, 좁은 화면에서는 ☰ 버튼을 누르면 펼쳐진다(자바스크립트 없이 <details>로 동작).
import { SITE, url } from '../site';
import Button from './Button.astro';

const linkClass =
  'flex min-h-11 items-center rounded-lg px-3 text-15 font-medium text-foreground-muted transition-colors hover:bg-surface hover:text-foreground';
---

<header class="sticky top-0 z-40 border-b border-border bg-background/95 backdrop-blur">
  <div class="mx-auto flex min-h-16 max-w-site items-center justify-between gap-4 px-gutter">
    <a href={url('/')} class="flex min-h-11 items-center text-18 font-extrabold tracking-tight text-foreground">
      {SITE.name}
    </a>

    <nav aria-label="주요 메뉴" class="hidden items-center gap-1 lg:flex">
      {SITE.nav.map(({ href, label }) => <a href={url(href)} class={linkClass}>{label}</a>)}
      <Button href={SITE.contact.kakao} class="ml-3">문의하기</Button>
    </nav>

    <details class="group relative lg:hidden">
      <summary
        class="flex size-11 cursor-pointer items-center justify-center rounded-lg text-foreground hover:bg-surface"
        aria-label="메뉴 열기"
      >
        <svg aria-hidden="true" class="group-open:hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg aria-hidden="true" class="hidden group-open:block" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </summary>
      <nav
        aria-label="주요 메뉴"
        class="absolute top-full right-0 mt-2 w-[min(32rem,calc(100vw-3.2rem))] rounded-2xl border border-border-accent bg-background p-2 shadow-lg"
      >
        {SITE.nav.map(({ href, label }) => <a href={url(href)} class={linkClass}>{label}</a>)}
        <div class="mt-2 border-t border-border pt-2">
          <Button href={SITE.contact.kakao} full>문의하기</Button>
        </div>
      </nav>
    </details>
  </div>
</header>
