---
// 첫 화면. 배경(사진 또는 하늘→초원 그라데이션) 위에 작은 문구·제목(h1)·가운데 이미지·회사명·버튼을 세로로 둔다.
// 글과 이미지는 src/content.ts의 hero에서 바꾼다. background에 사진을 넣으면 그라데이션 대신 사진이 깔린다.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { SITE } from '../site';
import Button from './Button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  name?: string; // 아래쪽 회사명 한 줄
  image?: ImageMetadata; // 가운데 이미지(로고 등)
  imageAlt?: string;
  background?: ImageMetadata; // 배경 사진(예: 들판의 나무)
  cta?: { label: string; href: string };
}
const { eyebrow, title, name, image, imageAlt = '', background, cta = { label: '우리 병원 브랜드 전략 제안 받기', href: SITE.contact.form } } = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-border text-center text-white">
  {
    background ? (
      <Image src={background} alt="" widths={[750, 1500]} sizes="100vw" class="slow-zoom-out absolute inset-0 -z-10 size-full object-cover object-[65%_60%]" loading="eager" fetchpriority="high" />
    ) : (
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1b5f8c_0%,#5e9fc6_38%,#a9d0e3_55%,#7fb23f_62%,#4f8a22_80%,#3b6d18_100%)]" />
    )
  }
  <!-- 사진을 어둡게 덮는 막. 숫자(/55)를 키우면 더 어두워진다 -->
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/55" />

  <div class="relative mx-auto flex min-h-[calc(100svh-6.4rem)] max-w-site flex-col items-center justify-end gap-10 px-gutter py-16">
    <!-- 헤드카피는 첫 화면 가운데보다 조금 위에 고정한다 -->
    <div class="absolute inset-x-0 top-[42%] -translate-y-1/2 px-gutter">
      {eyebrow && <p class="mb-4 text-16 font-bold md:text-20 [text-shadow:0_1px_6px_rgb(0_0_0/0.35)]">{eyebrow}</p>}
      <h1 class="text-40 leading-tight font-extrabold md:text-46 lg:text-[6.4rem] [text-shadow:0_2px_12px_rgb(0_0_0/0.35)]">{title}</h1>
    </div>

    {image && <Image src={image} alt={imageAlt} class="h-auto w-[28rem] max-w-full drop-shadow-[0_4px_16px_rgb(255_255_255/0.6)] md:w-[40rem]" loading="eager" />}

    <div class="flex flex-col items-center gap-4">
      <Button href={cta.href} size="sm">{cta.label}</Button>
      {name && <p class="text-18 font-bold md:text-22 [text-shadow:0_1px_6px_rgb(0_0_0/0.4)]">{name}</p>}
    </div>
  </div>
</section>
