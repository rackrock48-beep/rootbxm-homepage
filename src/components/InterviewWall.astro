---
// 원장님 인터뷰 컷 21장을 배경으로 깐다. 얼굴을 알아볼 수 없도록 미리 작게 줄이고 살짝 흐리게·어둡게 만든
// 이미지(src/assets/interview-blur.jpg)만 쓴다. 원본 사진은 사이트에 올라가지 않는다.
// 부모 요소에 relative isolate가 있어야 하고, 이 부품은 그 뒤쪽(-z-10)에 깔린다.
import { Image } from 'astro:assets';
import wall from '../assets/interview-blur.jpg';
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
  <Image src={wall} alt="" quality={70} class="absolute top-1/2 left-1/2 h-auto w-[110%] max-w-none -translate-x-1/2 -translate-y-1/2 rounded-2xl opacity-45 sm:w-[85%] lg:w-[68%]" />
  <!-- 가운데 글이 잘 읽히도록 가장자리만 사진이 비치게 어둡게 덮는다 -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgb(0_0_0/0.85)_0%,rgb(0_0_0/0.65)_45%,rgb(0_0_0/0.4)_100%)]"></div>
</div>
