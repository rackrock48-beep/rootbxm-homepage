---
// "ROOT BxM 약속" 섹션. 제목 → 대표의 한마디 → 약속 카드 6개(픽토그램).
// 글은 src/content.ts의 promise에서 바꾼다. 픽토그램은 아래 icons에 선 그림(SVG)으로 들어 있다.
import { promise } from '../content';

const { eyebrow, title, quote, signature, items } = promise;

// 선 굵기 1.6의 단순한 픽토그램(24×24 기준)
const icons: Record<string, string> = {
  // 메달: 처음 10곳만 모시는 Founding Partner
  award: '<circle cx="12" cy="9" r="5.5"/><path d="m8.5 13.3-1.5 7.2 5-2.6 5 2.6-1.5-7.2"/><path d="m10 9 1.4 1.4L14 7.8"/>',
  // 두 사람: 두 디렉터 공동 전담
  team: '<circle cx="9" cy="8" r="3"/><circle cx="16.5" cy="9" r="2.5"/><path d="M3.5 19.5c0-3 2.5-5.5 5.5-5.5s5.5 2.5 5.5 5.5"/><path d="M14.5 14.3c.6-.2 1.3-.3 2-.3 2.5 0 4.5 2 4.5 4.5"/>',
  // 사람 + 체크: 끝까지 같은 사람
  userCheck: '<circle cx="10" cy="8" r="3.5"/><path d="M3.5 20c0-3.6 2.9-6.5 6.5-6.5 1.4 0 2.7.4 3.7 1.2"/><path d="m15 18 2 2 4-4.5"/>',
  // 말풍선: 직통 소통
  chat: '<path d="M4 5.5h16v10H9l-5 4v-14Z"/><path d="M8 9.5h8M8 12.5h5"/>',
  // 지도 핀: 같은 진료권 한 곳만
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/>',
  // 방패 + 체크: 의료법 대비부터 해결까지
  shield: '<path d="M12 3.5 5 6v5.5c0 4.3 3 7.6 7 9 4-1.4 7-4.7 7-9V6l-7-2.5Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  // 실험 플라스크: 신규 콘텐츠 무료 테스트
  test: '<path d="M9.5 3.5h5M10.5 3.5v5.2L5.3 17.6A2 2 0 0 0 7 20.5h10a2 2 0 0 0 1.7-2.9l-5.2-8.9V3.5"/><path d="M7.8 14h8.4"/>',
  // 달력 + 반짝임: 3개월마다 새로운 제안
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><path d="M12 12.3v3.4M10.3 14h3.4"/>',
};
// 선이 그려지는 움직임을 위해 각 선(path·circle·rect)에 길이 기준(pathLength=1)을 붙인다
const drawable = (svg: string) => svg.replace(/<(path|circle|rect) /g, '<$1 pathLength="1" ');
---

<div class="mx-auto max-w-[96rem] text-center">
  <p class="mb-4 inline-flex rounded-lg bg-primary px-3 py-1 text-14 font-bold text-primary-foreground">{eyebrow}</p>
  <h2 class="text-20 leading-snug font-extrabold whitespace-pre-line md:text-36">{title}</h2>
</div>

<!-- 대표의 한마디 -->
<figure class="mx-auto mt-14 max-w-[96rem] border-t border-border-accent pt-12 text-center md:mt-16 md:pt-14">
  <blockquote class="text-20 leading-snug font-extrabold text-primary-bright md:text-28">{quote}</blockquote>
  <figcaption class="mt-3 text-15 font-semibold tracking-[0.15em] text-foreground-muted">{signature}</figcaption>
</figure>

<!-- 약속 카드 6개 -->
<ul class="mx-auto mt-14 grid max-w-[112rem] gap-4 sm:grid-cols-2 md:mt-16 lg:grid-cols-3 lg:gap-5">
  {
    items.map(({ icon, title, description }, i) => (
      <li class="flex flex-col rounded-3xl border border-border-accent bg-background p-7 md:p-8">
        <div class="flex items-center gap-4">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-primary-surface text-primary">
            <svg aria-hidden="true" class="icon-draw size-8" style={`animation-delay: ${i * 0.35}s`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={drawable(icons[icon])} />
          </span>
          <h3 class="text-20 font-extrabold">{title}</h3>
        </div>
        <p class="mt-5 text-15 leading-relaxed whitespace-pre-line text-foreground-muted">{description}</p>
      </li>
    ))
  }
</ul>

