---
// 화면 하단 고정 빠른 메뉴(연락하는 곳만): 브랜딩 제안(문의폼)·1:1 문의(전화·카카오톡이 있는 문의 섹션)·맨 위로. 자바스크립트 없음.
// 모바일: 화면 아래 가로 막대(바닥글에 같은 높이의 여백을 두어 가리지 않는다). 넓은 화면: 오른쪽 아래 세로 묶음.
import { SITE, url } from '../site';

const item =
  'flex min-h-14 flex-col items-center justify-center gap-1 t-body font-semibold text-foreground transition-colors hover:bg-surface lg:size-14 lg:rounded-xl';
const icon = 'size-5';
---

<nav
  aria-label="빠른 메뉴"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-border-accent bg-background/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:inset-x-auto lg:right-6 lg:bottom-6 lg:flex lg:flex-col lg:gap-1 lg:rounded-2xl lg:border lg:p-1 lg:pb-1 lg:shadow-lg"
>
  <!-- 브랜딩 제안: 문의폼(Tally)으로 간다. 초록 글씨로 눈에 띄게 -->
  <a href={SITE.contact.form} target="_blank" rel="noopener" class:list={[item, 'text-primary-bright lg:h-auto lg:py-2 lg:text-center lg:leading-tight']}>
    <svg aria-hidden="true" class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg>
    브랜딩 제안
  </a>
  <!-- 1:1 문의: 전화·카카오톡이 있는 문의 섹션으로 -->
  <a href={url('/#contact')} class:list={[item, 'lg:h-auto lg:py-2 lg:text-center lg:leading-tight']}>
    <svg aria-hidden="true" class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5h16v10H9l-5 4v-14Z"/><path d="M8 9.5h8M8 12.5h5"/></svg>
    1:1 문의
  </a>
  <a href={url('/#top')} class={item}>
    <svg aria-hidden="true" class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    맨 위로
  </a>
</nav>
