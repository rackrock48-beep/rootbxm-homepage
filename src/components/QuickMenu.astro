---
// 화면 하단 고정 빠른 메뉴: 전화·카카오톡·맨 위로. 자바스크립트 없음.
// 모바일: 화면 아래 가로 막대(바닥글에 같은 높이의 여백을 두어 가리지 않는다). 넓은 화면: 오른쪽 아래 세로 묶음.
import { SITE, url } from '../site';

const tel = `tel:${SITE.contact.phone.replace(/-/g, '')}`;
const item =
  'flex min-h-14 flex-col items-center justify-center gap-1 text-12 font-semibold text-foreground transition-colors hover:bg-surface lg:size-14 lg:rounded-xl';
const icon = 'size-5';
---

<nav
  aria-label="빠른 메뉴"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-border-accent bg-background/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:inset-x-auto lg:right-6 lg:bottom-6 lg:flex lg:flex-col lg:gap-1 lg:rounded-2xl lg:border lg:p-1 lg:pb-1 lg:shadow-lg"
>
  <a href={tel} class={item}>
    <svg aria-hidden="true" class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
    전화
  </a>
  <a href={SITE.contact.kakao} target="_blank" rel="noopener" class={item}>
    <svg aria-hidden="true" class={icon} viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.5 3 2 6.6 2 11c0 2.8 1.8 5.2 4.6 6.6L5.5 21l4.4-2.6c.7.1 1.4.2 2.1.2 5.5 0 10-3.6 10-8S17.5 3 12 3z"/></svg>
    카카오톡
  </a>
  <a href={url('/#top')} class={item}>
    <svg aria-hidden="true" class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    맨 위로
  </a>
</nav>
