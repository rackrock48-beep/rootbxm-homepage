---
// 페이지의 한 단락(섹션). 제목 묶음(작은 라벨 + 제목 + 설명)을 그리고 그 아래에 내용을 넣는다.
// id를 주면 메뉴에서 url('/#id')로 이동할 수 있다.
import Container from './Container.astro';

interface Props {
  id?: string;
  eyebrow?: string; // 제목 위 작은 라벨. 예: "서비스"
  title?: string; // 섹션 제목(h2)
  lead?: string; // 제목 아래 한두 문장
  tone?: 'white' | 'surface'; // 배경색. surface=연회색
  align?: 'left' | 'center';
  narrow?: boolean;
  class?: string;
}
const { id, eyebrow, title, lead, tone = 'white', align = 'left', narrow = false, class: className = '' } = Astro.props;
---

<section id={id} class:list={['py-section', tone === 'surface' ? 'bg-surface' : 'bg-background', className]}>
  <Container narrow={narrow}>
    {
      (eyebrow || title || lead) && (
        <div class:list={['mb-12 max-w-prose', align === 'center' && 'mx-auto text-center']}>
          {eyebrow && <p class="mb-3 text-14 font-semibold text-primary">{eyebrow}</p>}
          {title && <h2 class="text-28 font-bold whitespace-pre-line md:text-36">{title}</h2>}
          {lead && <p class="mt-4 text-16 whitespace-pre-line text-foreground-muted md:text-18">{lead}</p>}
        </div>
      )
    }
    <slot />
  </Container>
</section>
