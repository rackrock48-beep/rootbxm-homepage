---
// 한 줄 흐름도. 넓은 화면에서는 가로선 위에 점(번호)이 놓이고 점 아래에 제목·설명이 온다.
// 휴대폰에서는 세로선으로 바뀌어 점 오른쪽에 제목·설명이 온다. 글은 src/content.ts의 services에서 바꾼다.
interface Props {
  items: { title: string; description: string }[];
  care?: { title: string; lead: string; points: string[] };
}
const { items, care } = Astro.props;
---

<div class="flow-timeline relative mx-auto max-w-[24rem] lg:max-w-none" style={`--cols: ${items.length}`}>
  <!-- 선: 휴대폰은 가운데로 모은 목록의 번호 점을 잇는 세로선, 넓은 화면은 가로(첫 점 가운데~마지막 점 가운데) -->
  <span
    aria-hidden="true"
    class="flow-line absolute top-6 bottom-6 left-6 w-0.5 -translate-x-1/2 lg:translate-x-0 bg-gradient-to-b from-primary to-primary/30 lg:right-[calc(50%/var(--cols))] lg:bottom-auto lg:left-[calc(50%/var(--cols))] lg:h-0.5 lg:w-auto lg:bg-gradient-to-r"
  ></span>

  <ol class="relative grid gap-10 lg:grid-cols-[repeat(var(--cols),minmax(0,1fr))] lg:gap-6">
    {
      items.map(({ title, description }, i) => (
        <li style={`--i: ${i}`} class="flow-reveal grid grid-cols-[4.8rem_1fr] items-start gap-x-5 text-left lg:flex lg:flex-col lg:items-center lg:text-center">
          <span class="num-blink flex size-12 items-center justify-center rounded-full border-2 border-primary bg-background t-body font-extrabold text-primary" style={`animation-delay: ${[1.7, 0.3, 2.9, 1.1, 3.4, 0.6][i % 6]}s; animation-duration: ${[3.6, 4.2, 3.1, 4.7, 3.9, 3.3][i % 6]}s`}>
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="pt-2 lg:pt-6">
            <h3 class="t-head leading-snug font-extrabold whitespace-pre-line lg:min-h-[5.6rem]">{title}</h3>
            <p class="mt-3 t-body leading-relaxed whitespace-pre-line text-foreground-muted lg:mt-4 lg:border-t lg:border-border-accent lg:pt-4">{description}</p>
          </div>
        </li>
      ))
    }
  </ol>

</div>

  <!-- 의료법 케어: 넓은 화면에서는 01~06 아래를 괄호처럼 감싸는 선이 가운데로 모여 상자로 이어진다 -->
  {care && (
    <div class="mt-12 lg:mt-14" style={`--cols: ${items.length}`}>
      <div aria-hidden="true" class="mx-[calc(50%/var(--cols))] hidden h-8 rounded-b-2xl border-x-2 border-b-2 border-primary/60 lg:block" />
      <div aria-hidden="true" class="mx-auto h-10 w-0.5 bg-primary/60 max-lg:hidden" />
      <div class="mx-auto max-w-[96rem] pt-4 text-center">
        <p class="t-body font-bold text-primary-bright max-lg:inline-flex max-lg:rounded-lg max-lg:bg-primary max-lg:px-4 max-lg:py-1.5 max-lg:text-primary-foreground">{care.title}</p>
        <h3 class="mt-2 t-head leading-snug font-extrabold">{care.lead}</h3>
        <p class="mt-4 t-body leading-relaxed text-foreground-muted">
          {care.points.map((t, i) => (<>{i > 0 && <span aria-hidden="true" class="mx-2 text-primary/60 max-sm:hidden">·</span>}<span class="max-sm:block">{t}</span></>))}
        </p>
      </div>
    </div>
  )}
