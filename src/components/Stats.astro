---
// 성과 카드. 카드마다 [병원명]·설명·큰 숫자. 글은 src/content.ts의 results에서 바꾼다.
// 카드를 누르면 그 병원의 자세한 이야기(/results/slug/, 글은 src/cases.ts)로 간다.
import { url } from '../site';
import bg1 from '../assets/result-bg-1.jpg';
import bg2 from '../assets/result-bg-2.jpg';
import bg3 from '../assets/result-bg-3.jpg';
import bg4 from '../assets/result-bg-4.jpg';
// 카드 배경: 위 인터뷰 띠에서 잘라 낸 원장님 사진. 카드 순서대로 하나씩, 어둡게 눌러 깐다.
const bgs = [bg1, bg2, bg3, bg4];

interface Props {
  items: { slug: string; label: string; description: string; metric: string; value: string }[];
}
const { items } = Astro.props;
---

<ul class="mx-auto grid max-w-[120rem] gap-6 md:grid-cols-2 md:gap-8">
  {
    items.map(({ slug, label, description, metric, value }, i) => (
      <li>
        <a href={url(`/results/${slug}/`)} class="group relative isolate flex h-full flex-col overflow-hidden rounded-4xl border border-transparent bg-surface-accent bg-cover bg-center p-8 md:p-12 transition-colors hover:border-primary" style={`background-image: url(${bgs[i % bgs.length].src})`}>
          <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/75" />
          <p class="text-[1.9rem] md:text-[2.1rem] leading-tight font-bold text-primary-bright">[{label}]</p>
          <p class="mt-5 text-[1.2rem] md:text-[1.45rem] font-semibold whitespace-pre-line text-foreground">{description}</p>
          <!-- 숫자가 무엇인지(기간·지표): 큰 숫자 바로 위에 크게 -->
          <p class="mt-auto pt-6 text-[1.2rem] md:text-[1.45rem] leading-snug font-bold whitespace-pre-line text-foreground">{metric}</p>
          <p class="mt-2 text-[3.3rem] leading-none font-extrabold text-primary-bright md:text-[4.8rem]">{value}</p>
          <span class="mt-6 inline-flex items-center gap-1 text-[1.1rem] md:text-[1.1rem] font-bold text-primary-bright">
            자세히 보기 <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
