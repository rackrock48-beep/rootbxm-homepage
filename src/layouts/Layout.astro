---
import '../styles/global.css';
import { SITE, url } from '../site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickMenu from '../components/QuickMenu.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = SITE.description, image = SITE.ogImage, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: new URL(url('/'), Astro.site).href,
  logo: new URL(url('/favicon.svg'), Astro.site).href,
  telephone: SITE.contact.phone,
  email: SITE.contact.email,
  address: { '@type': 'PostalAddress', streetAddress: SITE.contact.address, addressCountry: 'KR' },
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}
    {SITE.verification.naver && <meta name="naver-site-verification" content={SITE.verification.naver} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body id="top" class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <QuickMenu />
  </body>
</html>
