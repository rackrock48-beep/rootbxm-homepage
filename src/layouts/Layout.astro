---
import '../styles/global.css';
import { SITE, url } from '../site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickMenu from '../components/QuickMenu.astro';

import { baseSchema } from '../seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  // 이 페이지에만 붙일 구조화데이터(FAQ, 사례 글, 페이지 위치 등). 회사 정보는 모든 페이지에 자동으로 붙는다.
  schema?: object[];
  // 칼럼처럼 "글"인 페이지: 공유·검색에 글로 알리고, 쓴 날짜와 글쓴이를 함께 적는다
  article?: { published: string; author: string };
}

const { title, description = SITE.description, image = SITE.ogImage, noindex = false, schema = [], article } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const jsonLd = [...baseSchema(Astro.site!), ...schema];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- 브라우저 탭·북마크·휴대폰 홈 화면 아이콘: 루트 나무 마크(public/favicon-*.png, favicon.ico) -->
    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="512x512" href={url('/favicon-512.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="text/markdown" title="llms.txt" href={url('/llms.txt')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} 원장님 고민`} href={url('/rss.xml')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta name="author" content={article.author} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}
    {SITE.verification.naver && <meta name="naver-site-verification" content={SITE.verification.naver} />}

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body id="top" class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <QuickMenu />
  </body>
</html>
