---
import '../styles/global.css';
import { SITE, url } from '../site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickMenu from '../components/QuickMenu.astro';

import { baseSchema } from '../seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  // 이 페이지에만 붙일 구조화데이터(FAQ, 사례 글, 페이지 위치 등). 회사 정보는 모든 페이지에 자동으로 붙는다.
  schema?: object[];
}

const { title, description = SITE.description, image = SITE.ogImage, noindex = false, schema = [] } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const jsonLd = [...baseSchema(Astro.site!), ...schema];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" href={url('/favicon.ico')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="text/markdown" title="llms.txt" href={url('/llms.txt')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}
    {SITE.verification.naver && <meta name="naver-site-verification" content={SITE.verification.naver} />}

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body id="top" class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <QuickMenu />
  </body>
</html>
