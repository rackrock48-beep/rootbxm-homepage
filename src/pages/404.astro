---
import Layout from '../layouts/Layout.astro';
import { url } from '../site';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
---

<Layout title="페이지를 찾을 수 없습니다" noindex>
  <Section narrow class="text-center">
    <p class="text-14 font-semibold text-primary">404</p>
    <h1 class="mt-3 text-28 font-bold md:text-36">찾으시는 페이지가 없습니다</h1>
    <p class="mt-4 text-16 text-foreground-muted">주소가 바뀌었거나 잘못 입력되었을 수 있습니다.</p>
    <div class="mt-8 flex justify-center gap-3">
      <Button href={url('/')}>홈으로</Button>
      <Button href={url('/#contact')} variant="secondary">문의하기</Button>
    </div>
  </Section>
</Layout>
