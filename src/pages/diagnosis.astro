---
// 원장님 성향 테스트(병원 브랜딩 타입 진단, 17문항) 페이지(/diagnosis).
// 문항·타입 글은 src/diagnosis.ts에서 고친다.
// 이 페이지만 예외로 짧은 자바스크립트(아래 <script>)를 쓴다. 답을 더해 타입을 고르는 계산이라 CSS만으로는 할 수 없다. 외부 라이브러리는 쓰지 않는다.
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { url, SITE } from '../site';
import { axes, subjects, questions, order, types } from '../diagnosis';
import { breadcrumb } from '../seo';

const ordered = order.map((no) => questions.find((q) => q.no === no)!);
const schema = [breadcrumb(Astro.site!, [{ name: '원장님 성향 테스트', path: '/diagnosis/' }])];

// 계산에 필요한 값만 브라우저로 넘긴다
const data = {
  axes: axes.map(({ key, left, right, core }) => ({ key, left: left.side, right: right.side, core })),
  questions: questions.map(({ no }) => no),
  names: Object.fromEntries(types.map((t) => [t.code, t.name])),
};
---

<Layout title="원장님 성향 테스트 · 병원 브랜딩 타입" description="17개 질문으로 원장님이 만들고 싶은 병원의 브랜딩 타입을 알아보세요. 원장님 성향에 따라 병원 브랜딩의 얼굴, 말투, 무대가 달라집니다." schema={schema}>
  <Section narrow>
    <a href={url('/')} class="inline-flex min-h-11 items-center gap-2 t-mid font-semibold text-foreground-muted hover:text-primary">
      <span aria-hidden="true">←</span> 홈으로 돌아가기
    </a>

    <header class="mt-6">
      <p class="mb-4 inline-flex rounded-lg bg-primary px-3 py-1 t-mid font-bold text-primary-foreground">원장님 성향 테스트</p>
      <h1 class="t-headline leading-snug font-extrabold">원장님은 어떤 병원을<br />만들고 싶으신가요?</h1>
      <p class="mt-4 t-head leading-relaxed text-foreground-muted">
        병원 브랜딩은 원장님을 아는 데서 시작합니다. 원장님 성향에 따라 브랜드의 얼굴도, 환자에게 건네는 말투도, 선택받는 무대도 달라집니다.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2 t-body font-semibold text-foreground-muted">
        <li class="rounded-full border border-border-accent px-4 py-1.5">약 3분</li>
        <li class="rounded-full border border-border-accent px-4 py-1.5">결과 바로 확인</li>
      </ul>
      <p class="mt-8 rounded-xl bg-primary-surface px-5 py-4 t-mid leading-relaxed">
        지금 병원의 모습보다, <strong>원장님이 앞으로 만들고 싶은 병원</strong>을 떠올리며 가장 가까운 답을 골라 주세요. 정답은 없습니다.
      </p>
    </header>

    <form id="diag" class="mt-12" novalidate>
      <fieldset data-q="subject" class="scroll-mt-28 border-t border-border-accent py-8 [&.diag-missing_legend]:text-warning">
        <legend class="float-left mb-5 w-full t-head font-bold leading-snug">
          <span class="mr-2 text-primary-bright">0</span>진료과목을 골라 주세요.
        </legend>
        <div class="clear-both flex flex-wrap gap-2">
          {subjects.map((s) => (
            <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-border-accent bg-surface-accent px-5 py-2 t-mid font-semibold transition-colors hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary-surface">
              <input type="radio" name="subject" value={s.value} data-beauty={s.beauty ? 'true' : undefined} class="accent-primary" />
              {s.label}
            </label>
          ))}
        </div>
      </fieldset>

      {ordered.map((q, i) => (
        <fieldset data-q={q.no} class="scroll-mt-28 border-t border-border-accent py-8 [&.diag-missing_legend]:text-warning">
          <legend class="float-left mb-5 w-full t-head font-bold leading-snug">
            <span class="mr-2 text-primary-bright tabular-nums">{i + 1}</span>{q.text}
          </legend>
          <div class="clear-both grid gap-2">
            {q.options.map((o) => (
              <label class="flex min-h-12 cursor-pointer items-start gap-3 rounded-xl border border-border-accent bg-surface-accent px-4 py-3 t-mid leading-relaxed transition-colors hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary-surface">
                <input type="radio" name={`q${q.no}`} value={o.score} class="mt-1.5 shrink-0 accent-primary" />
                <span>{o.text}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}

      <div class="border-t border-border-accent pt-8 text-center">
        <p id="diag-progress" class="t-mid font-semibold text-foreground-muted" aria-live="polite">18개 중 0개 답했어요</p>
        <p id="diag-error" class="mt-2 t-mid font-semibold text-warning" hidden>아직 답하지 않은 질문이 있어요. 표시된 질문부터 골라 주세요.</p>
        <Button type="submit" variant="primary" size="lg" class="mt-5">결과 보기</Button>
      </div>
    </form>

    <!-- 결과. 처음엔 숨겨 두고, 다 답하면 계산해서 보여준다 -->
    <section id="diag-result" class="mt-16 scroll-mt-28" aria-labelledby="diag-result-title" hidden>
      <div class="rounded-3xl border border-primary bg-surface px-6 py-10 md:px-10">
        <p class="t-mid font-semibold text-foreground-muted">원장님이 만들고 싶은 병원은</p>

        {types.map((t) => (
          <div data-type={t.code} hidden>
            <h2 id={`diag-type-${t.code}`} class="mt-2 t-headline leading-snug font-extrabold text-primary-bright">{t.name}</h2>
            <p class="mt-4 font-serif t-head font-bold leading-relaxed">“{t.quote}”</p>
            <p class="mt-1 t-body text-foreground-muted">환자가 우리 병원을 떠올리는 한 문장</p>

            <!-- 원장님 성향 -->
            <p class="mt-8 t-mid leading-relaxed">{t.persona}</p>
          </div>
        ))}

        <!-- 원장님의 네 가지 기준: 성향 바로 아래, 강점 위 -->
        <h3 id="diag-result-title" class="mt-10 t-mid font-bold">원장님의 네 가지 기준</h3>
        <ul class="mt-4 space-y-6">
          {axes.map((a) => (
            <li data-axis={a.key}>
              <p class="t-body text-foreground-muted">{a.question} <span data-balance class="ml-1 font-semibold text-primary-bright" hidden>(균형)</span></p>
              <div class="mt-2 grid grid-cols-[minmax(7.2rem,auto)_1fr_minmax(7.2rem,auto)] items-center gap-3 t-body font-semibold">
                <span><span data-left-pct class="tabular-nums">0</span>% {a.left.label}</span>
                <span class="h-3 overflow-hidden rounded-full bg-border-accent" aria-hidden="true">
                  <span data-fill class="block h-full rounded-full bg-primary" style="width: 50%"></span>
                </span>
                <span class="text-right">{a.right.label} <span data-right-pct class="tabular-nums">0</span>%</span>
              </div>
            </li>
          ))}
        </ul>

        <!-- 타입별 요약(강점 · 브랜딩 방향 · 마케팅 방식) → 자세한 설명 → 성장 포인트. 위 타입과 같은 data-type이라 함께 보이고 숨는다 -->
        {types.map((t) => (
          <div data-type={t.code} hidden>
            <dl class="mt-10 divide-y divide-border-accent border-y border-border-accent">
              <div class="grid gap-1 py-4 md:grid-cols-[11rem_1fr] md:gap-6">
                <dt class="t-body font-bold text-primary-bright">강점</dt>
                <dd class="t-mid leading-relaxed">{t.strengths.join(' ')}</dd>
              </div>
              <div class="grid gap-1 py-4 md:grid-cols-[11rem_1fr] md:gap-6">
                <dt class="t-body font-bold text-primary-bright">브랜딩 방향</dt>
                <dd class="t-mid leading-relaxed">{t.branding}</dd>
              </div>
              <div class="grid gap-1 py-4 md:grid-cols-[11rem_1fr] md:gap-6">
                <dt class="t-body font-bold text-primary-bright">마케팅 방식</dt>
                <dd class="t-mid leading-relaxed">{t.marketing}</dd>
              </div>
            </dl>

            <!-- 자세한 설명 -->
            <p class="mt-8 t-mid leading-[1.9] text-foreground-muted">{t.detail}</p>

            <!-- 한 단계 더 성장하려면 -->
            <div class="mt-8 rounded-2xl bg-primary-surface px-5 py-6 md:px-7">
              <h3 class="t-body font-bold text-primary-bright">한 단계 더 성장하려면</h3>
              <p class="mt-2 t-head leading-snug font-extrabold">{t.growthTitle}에 집중하셔야 합니다.</p>
              <p class="mt-3 t-mid leading-relaxed text-foreground-muted">{t.growth}</p>
            </div>
          </div>
        ))}


        <p id="diag-beauty" class="mt-6 rounded-xl border border-border-accent px-5 py-4 t-body leading-relaxed text-foreground-muted" hidden>
          미용피부과·성형외과 원장님을 위한 진단은 준비 중입니다. 지금 결과는 진료 중심 병원 기준이며, 미팅에서 미용 진료에 맞춰 다시 해석해 드립니다.
        </p>

        <p class="mt-8 t-body leading-relaxed text-foreground-muted">
          어느 쪽이 더 좋은 것은 아닙니다. 방향이 다를 뿐이고, 방향이 다르면 브랜딩이 달라집니다.
        </p>

        <!-- 브랜딩 제안 받기: 결과 설명의 맨 마지막. 본문과 구분되는 명조체 안내 -->
        <div class="mt-10 border-t border-border-accent pt-8 text-center">
          <p class="font-serif t-mid leading-relaxed italic text-foreground-muted">원장님의 더 자세한 성향과 우리 병원에 꼭 맞는 브랜딩 방향이 궁금하시다면,<br class="max-md:hidden" /> 노규락 대표가 직접 분석해 브랜딩 제안서로 답해 드립니다.</p>
          <Button href={SITE.contact.form} variant="primary" size="lg" class="mt-6">우리 병원 브랜딩 제안 받기</Button>
          <div class="mt-4"><Button id="diag-retry" variant="ghost" size="md">다시 해보기</Button></div>
        </div>
      </div>
    </section>
  </Section>

  <script type="application/json" id="diag-data" set:html={JSON.stringify(data)} />
</Layout>

<script>
  type Axis = { key: string; left: string; right: string; core: number };
  const data = JSON.parse(document.getElementById('diag-data')!.textContent!) as {
    axes: Axis[];
    questions: number[];
    names: Record<string, string>;
  };
  const form = document.getElementById('diag') as HTMLFormElement;
  const result = document.getElementById('diag-result')!;
  const progress = document.getElementById('diag-progress')!;
  const error = document.getElementById('diag-error')!;
  const names = ['subject', ...data.questions.map((n) => `q${n}`)];

  const picked = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);

  function updateProgress() {
    const done = names.filter((n) => picked(n)).length;
    progress.textContent = `${names.length}개 중 ${done}개 답했어요`;
    form.querySelectorAll('fieldset').forEach((f) => {
      const n = f.dataset.q === 'subject' ? 'subject' : `q${f.dataset.q}`;
      if (picked(n)) f.classList.remove('diag-missing');
    });
  }

  form.addEventListener('change', updateProgress);

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const missing = names.filter((n) => !picked(n));
    form.querySelectorAll('fieldset').forEach((f) => {
      const n = f.dataset.q === 'subject' ? 'subject' : `q${f.dataset.q}`;
      f.classList.toggle('diag-missing', missing.includes(n));
    });
    if (missing.length) {
      error.hidden = false;
      form.querySelector('.diag-missing')?.scrollIntoView({ behavior: 'smooth' });
      return;
    }
    error.hidden = true;

    // 점수 더하기: 'D2' → D 쪽 2점
    const score: Record<string, number> = {};
    data.questions.forEach((n) => {
      const v = picked(`q${n}`)!.value;
      score[v[0]] = (score[v[0]] ?? 0) + Number(v.slice(1));
    });

    // 기준마다 더 높은 쪽. 같으면 그 기준의 핵심 문항에서 고른 쪽
    const letters: Record<string, string> = {};
    const leftPct: Record<string, number> = {};
    data.axes.forEach((a) => {
      const l = score[a.left] ?? 0;
      const r = score[a.right] ?? 0;
      leftPct[a.key] = Math.round((l / (l + r)) * 100);
      letters[a.key] = l > r ? a.left : r > l ? a.right : picked(`q${a.core}`)!.value[0];
    });
    const flip = (a: Axis) => (letters[a.key] === a.left ? a.right : a.left);
    const codeWith = (over?: Axis) =>
      data.axes.map((a) => (a === over ? flip(a) : letters[a.key])).join('');
    // 타입 코드: 원장/팀 · 설명/실력 · 동네/전문 글자를 이어 붙인 것(예: DCL)
    const code = codeWith();

    result.querySelectorAll<HTMLElement>('[data-type]').forEach((el) => (el.hidden = el.dataset.type !== code));

    data.axes.forEach((a) => {
      const row = result.querySelector<HTMLElement>(`[data-axis="${a.key}"]`)!;
      const p = leftPct[a.key];
      row.querySelector<HTMLElement>('[data-fill]')!.style.width = `${p}%`;
      row.querySelector('[data-left-pct]')!.textContent = String(p);
      row.querySelector('[data-right-pct]')!.textContent = String(100 - p);
      row.querySelector<HTMLElement>('[data-balance]')!.hidden = p < 40 || p > 60;
    });

    document.getElementById('diag-beauty')!.hidden = picked('subject')!.dataset.beauty !== 'true';

    result.hidden = false;
    result.scrollIntoView({ behavior: 'smooth' });
  });

  document.getElementById('diag-retry')!.addEventListener('click', () => {
    form.reset();
    result.hidden = true;
    updateProgress();
    form.scrollIntoView({ behavior: 'smooth' });
  });
</script>
