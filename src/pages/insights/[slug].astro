---
// 칼럼 한 편의 개별 주소(/insights/주소이름/). 글은 src/insights.ts에서 쓴다.
// 사람은 주로 첫 페이지 "원장님 고민" 섹션에서 읽고, 이 페이지는 검색·AI·네이버가 글 하나하나를 따로 찾아 보여 주도록 둔다.
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import ColumnBody from '../../components/ColumnBody.astro';
import { url, SITE } from '../../site';
import { shownColumns as columns } from '../../insights';
import { breadcrumb, columnSchema } from '../../seo';

export function getStaticPaths() {
  return columns.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const others = columns.filter((o) => o.slug !== c.slug).slice(0, 3);
const site = Astro.site!;
const schema = [
  breadcrumb(site, [
    { name: '원장님 고민', path: '/#insights' },
    { name: c.title, path: `/insights/${c.slug}/` },
  ]),
  columnSchema(c, site),
];
const dot = (d: string) => d.replaceAll('-', '.');
---

<Layout title={c.title} description={c.summary} schema={schema} article={{ published: c.date, author: c.author }}>
  <Section narrow>
    <a href={url('/#insights')} class="inline-flex min-h-11 items-center gap-2 t-body font-semibold text-foreground-muted hover:text-primary">
      <span aria-hidden="true">←</span> 원장님 고민
    </a>

    <article class="mx-auto mt-10 max-w-[68rem]">
      <header class="border-b border-border-accent pb-10 text-center">
        <p class="t-body font-semibold tracking-[0.3em] text-primary">COLUMN</p>
        <h1 class="mt-6 font-serif t-headline leading-snug font-bold">{c.title}</h1>
        <p class="mt-6 t-body text-foreground-subtle">
          <span>{c.author}</span><span aria-hidden="true" class="mx-3">·</span><time datetime={c.date} class="tabular-nums">{dot(c.date)}</time>
        </p>
      </header>

      <div class="mt-12"><ColumnBody body={c.body} /></div>

      <footer class="mt-16 rounded-2xl border border-border-accent px-6 py-8 text-center md:px-10">
        <p class="font-serif t-mid font-bold">우리 병원에 맞는 방향이 궁금하시다면</p>
        <p class="mt-2 t-body text-foreground-muted">대표가 직접 듣고, 브랜딩 제안서로 답해 드립니다.</p>
        <div class="mt-6"><Button href={SITE.contact.form} variant="primary">우리 병원 브랜딩 제안 받기</Button></div>
      </footer>
    </article>

    {others.length > 0 && (
      <nav aria-label="다른 칼럼" class="mx-auto mt-16 max-w-[68rem] border-t border-border-accent pt-8">
        <p class="t-body font-semibold tracking-[0.3em] text-foreground-muted">MORE</p>
        <ul class="mt-4">
          {others.map((o) => (
            <li class="border-b border-border-accent">
              <a href={url(`/insights/${o.slug}/`)} class="group flex items-baseline justify-between gap-6 py-5">
                <span class="font-serif t-mid font-bold transition-colors group-hover:text-primary-bright">{o.title}</span>
                <time datetime={o.date} class="shrink-0 t-body tabular-nums text-foreground-subtle">{dot(o.date)}</time>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </Section>
</Layout>
